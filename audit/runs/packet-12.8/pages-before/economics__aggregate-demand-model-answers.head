{
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What are the components of aggregate demand?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Aggregate demand (AD) = C + I + G + (X − M), where C is consumer spending, I is investment by firms, G is government spending, and (X − M) is net exports (exports minus imports). A change in any component shifts the AD curve."
   }
  },
  {
   "@type": "Question",
   "name": "What causes the AD curve to shift right?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "AD shifts right when total spending increases. Common causes include: lower interest rates (increases C and I), tax cuts (increases disposable income and C), increased government spending (G rises), a weaker exchange rate (boosts X, reduces M), or rising consumer confidence (increases C)."
   }
  }
 ]
}
