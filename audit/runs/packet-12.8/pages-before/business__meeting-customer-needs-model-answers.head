{
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What is market segmentation in business?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Market segmentation is dividing a market into distinct groups of consumers who share similar characteristics or needs — for example, by age, income, location, or lifestyle. It allows businesses to target their marketing mix more precisely at each group, increasing the likelihood of meeting customer needs and boosting sales."
   }
  },
  {
   "@type": "Question",
   "name": "Why is meeting customer needs important for a business?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Meeting customer needs is essential because it drives sales, builds customer loyalty, and generates repeat business. A business that understands what customers want can design products, set prices, and choose distribution channels that align with those needs, giving it a competitive advantage over rivals that take a less targeted approach."
   }
  },
  {
   "@type": "Question",
   "name": "What is the difference between primary and secondary market research?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Primary research involves collecting original, first-hand data directly from consumers through methods like surveys, interviews, and focus groups. Secondary research uses existing data that has already been collected by others, such as government statistics, trade reports, and competitor websites. Primary is more specific but expensive; secondary is cheaper but may be outdated or too general."
   }
  },
  {
   "@type": "Question",
   "name": "What are the limitations of primary market research?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Primary research is expensive and time-consuming to conduct. Small sample sizes may not be representative of the wider market. Respondents may give socially desirable answers rather than honest opinions. Results can be misinterpreted without proper data analysis expertise. For start-ups with limited budgets, the cost may be prohibitive."
   }
  }
 ]
}
