{
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "How do you calculate the break-even point?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Break-even output = Fixed Costs ÷ Contribution per Unit, where Contribution per Unit = Selling Price − Variable Cost per Unit. For example, if fixed costs are £10,000, selling price is £25, and variable cost is £15, then contribution = £10 and break-even = 1,000 units."
   }
  },
  {
   "@type": "Question",
   "name": "What are the limitations of break-even analysis?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Break-even analysis assumes all output is sold, costs can be neatly split into fixed and variable, prices remain constant, and there is only one product. In reality, businesses face fluctuating demand, semi-variable costs, price changes, and multiple product lines. It also ignores cash flow timing — a business can break even on paper but fail if payments are delayed."
   }
  }
 ]
}
