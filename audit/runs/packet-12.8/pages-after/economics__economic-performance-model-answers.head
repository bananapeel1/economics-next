{
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "How does the CPI measure inflation?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The Consumer Price Index (CPI) measures inflation by tracking the prices of a representative basket of approximately 700 goods and services, weighted by typical household spending patterns. The basket is updated annually to reflect changing consumption habits. CPI compares current prices to a base year (index = 100) — if CPI rises from 100 to 103, the inflation rate is 3%."
   }
  },
  {
   "@type": "Question",
   "name": "What are the main types of unemployment?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The main types are: cyclical (demand-deficient) unemployment caused by falls in aggregate demand during recessions; structural unemployment from skills mismatches due to changing industry structure; frictional unemployment from workers being between jobs; and seasonal unemployment from time-dependent demand. Each type requires different policy responses."
   }
  }
 ]
}
