{
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "How do you explain a negative externality for Edexcel IAL Economics?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Define a negative externality as a spill-over cost imposed on third parties not involved in the transaction. Give a specific example (e.g. factory pollution causing health problems for local residents). Explain that because external costs are not reflected in the market price, the good is over-produced relative to the socially optimal level."
   }
  },
  {
   "@type": "Question",
   "name": "What is the difference between private costs and social costs?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Private costs are costs borne by the producer or consumer in a transaction. Social costs include private costs plus any external costs imposed on third parties. When social costs exceed private costs, a negative externality exists, and the market over-produces the good because firms only consider their private costs when making production decisions."
   }
  }
 ]
}
