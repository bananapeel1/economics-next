{
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What is Maslow's hierarchy of needs?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Maslow's hierarchy arranges human needs into five levels: physiological (food, shelter), safety (job security), social (belonging, teamwork), esteem (recognition, status), and self-actualisation (reaching full potential). Lower-level needs must be satisfied before higher-level needs become motivating factors for employees."
   }
  },
  {
   "@type": "Question",
   "name": "What are the advantages of internal recruitment?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Internal recruitment is faster and cheaper than external recruitment — no advertising or lengthy induction needed. The candidate already knows the company culture and processes. It also motivates existing staff by showing that promotion opportunities exist, improving retention and reducing turnover costs."
   }
  }
 ]
}
