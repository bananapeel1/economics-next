{
  "name": "economics-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "contrast": "node audit/scripts/contrast-check.mjs",
    "quant-check": "node audit/scripts/quant-check.mjs",
    "pin-check": "node audit/scripts/pin-check.mjs --max-broken 15",
    "exposure": "node audit/scripts/exposure-census.mjs --both --check",
    "recalls": "node audit/scripts/recall-census.mjs --check",
    "diagrams": "node audit/scripts/diagram-pins.mjs",
    "validate": "node audit/scripts/validate-content.mjs && node audit/scripts/validate-model-answers.mjs",
    "validate:model-answers": "node audit/scripts/validate-model-answers.mjs",
    "validate:baseline": "node audit/scripts/validate-content.mjs --baseline",
    "test": "node --test lib/content-validator.test.mjs lib/write-path.test.mjs lib/read-path.test.mjs lib/parse-inline-markdown.test.mjs lib/flow-step.test.mjs lib/learn-steps.test.mjs lib/preview-limits.test.mjs lib/pretest-pool.test.mjs lib/recall-widgets.test.mjs lib/practice-tariffs.test.mjs lib/spec-coverage.test.mjs lib/mid-band-answer.test.mjs lib/diagram-enlarge.test.mjs lib/quant-pool.test.mjs audit/scripts/spec-coverage.test.mjs audit/scripts/checkin-attribution.test.mjs",
    "spec-items": "node audit/scripts/build-spec-items.mjs --check",
    "tariff-census": "node audit/scripts/build-tariff-census.mjs --check",
    "spec-coverage": "node audit/scripts/spec-coverage-check.mjs",
    "spec-overlap": "node audit/scripts/spec-overlap.mjs",
    "attribution": "node audit/scripts/checkin-attribution.mjs --both --check"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/react": "^3.0.118",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "ai": "^6.0.116",
    "framer-motion": "^12.36.0",
    "next": "^16.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "postgres": "^3.4.8"
  }
}
